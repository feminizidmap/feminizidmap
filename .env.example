# Full URL of the dataset endpoint (not just the API base URL)
NEXT_PUBLIC_CASES_URL="https://api.feminizidmap.org/cases"

# Strapi base URL for page content and uploads (read at build time)
NEXT_PUBLIC_STRAPI_URL="https://backend.feminizidmap.org"

# Read-only Strapi API token (custom token, `find` on the website types). Required for prod Strapi,
# optional locally as long as the local public role can read the content. Never prefix with NEXT_PUBLIC_.
STRAPI_API_TOKEN=""
